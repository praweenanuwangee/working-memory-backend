{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "app.js",
      "bindings": [
        { "type": "service", "service": "ml", "format": "url", "env": "ML_SERVICE_URL" }
      ],
      "functions": {
        "app.js": {
          "maxDuration": 120,
          "excludeFiles": "{ml/**,api/**,test/**,.tmp-wheel-audit/**,.tmp-python-service/**}"
        }
      }
    },
    "ml": {
      "root": "ml",
      "runtime": "python",
      "framework": "flask",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 120,
          "includeFiles": "shape.onnx",
          "excludeFiles": "{*.pt,predict.py,requirements-export.txt,test-circle.jpeg,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
