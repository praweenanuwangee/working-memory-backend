PORT=4000
NODE_ENV=development
# Single origin (legacy)
CLIENT_URL=http://localhost:5173
# Comma-separated multi-origin (takes precedence over CLIENT_URL when set)
# CLIENT_URLS=http://localhost:5173,https://your-production-domain.com
MONGODB_URI=mongodb+srv://praweenanuwangi_db_user:<db_password>@cluster0.nlp0v5g.mongodb.net/working-memory-backend?retryWrites=true&w=majority&appName=Cluster0
DNS_SERVERS=8.8.8.8,1.1.1.1
# Local Node-only runs use the Python CLI; vercel dev injects the service binding
# PYTHON_EXECUTABLE=python
# Bound ML request timeout: positive integer at most 110000 milliseconds
PREDICTION_TIMEOUT_MS=60000
# Vercel project setting: enables Python bundles up to 5 GB (Large Functions beta)
# Requires Fluid Compute with Active CPU, without Secure Compute or Static IPs
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
# ML_SERVICE_URL is injected by Vercel's app -> ml binding. Do not set it manually.
